<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.arthi.retail.controllers.LoginController"
      alignment="CENTER"
      spacing="18"
      prefWidth="700"
      prefHeight="750"
      styleClass="root">
    
    <Label text="Arthi Digital Enterprises" styleClass="app-title"/>
    <Label text="Welcome Back" styleClass="heading"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="300"/>


<StackPane maxWidth="300">

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="300"
                   style="-fx-padding: 13 45 13 12;"/>

    <TextField fx:id="visiblePasswordField"
               promptText="Password"
               visible="false"
               managed="false"
               maxWidth="300"
               style="-fx-padding: 13 45 13 12;"/>

    <Button fx:id="togglePasswordButton"
            text="👁"
            onAction="#togglePassword"
            styleClass="toggle-password-button"
            StackPane.alignment="CENTER_RIGHT"
            translateX="-8"
            style="-fx-background-color: transparent;
                   -fx-font-size: 19px;
                   -fx-padding: 5;
                   -fx-cursor: hand;"/>

</StackPane>


    <Label fx:id="messageLabel"
           text=""
           wrapText="true"
           styleClass="message"/>

    <Button text="LOGIN"
            onAction="#handleLogin"
            maxWidth="300"
            styleClass="primary-button"/>

    <Button text="Forgot Credentials?"
            onAction="#handleForgotCredentials"
            maxWidth="300"
            styleClass="primary-button"/>

</VBox>
